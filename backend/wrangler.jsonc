{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mangapages-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "alias": { "@/": "./src/" },
  // One limiter per route limit (requests per IP per 60s)
  "ratelimits": [
    { "name": "RL_DEFAULT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_MAL", "namespace_id": "1002", "simple": { "limit": 50, "period": 60 } },
    { "name": "RL_RANDOM", "namespace_id": "1003", "simple": { "limit": 100, "period": 60 } },
    { "name": "RL_SEARCH", "namespace_id": "1004", "simple": { "limit": 500, "period": 60 } },
  ],
}
